# Copy to .env for local development. Never commit real values.

# Postgres. Locally: `just db-up` starts this one.
# On Neon: the pooled string here, and the direct string in DATABASE_URL_UNPOOLED for migrations.
DATABASE_URL=postgres://watchpost:watchpost@localhost:5433/watchpost
# DATABASE_URL_UNPOOLED=

# Public URL of the site, used in feeds, sitemaps and llms.txt. Falls back to VERCEL_URL on previews.
SITE_URL=http://localhost:3000

# Vercel Cron sends this as a Bearer token. Generate with: openssl rand -base64 32
CRON_SECRET=dev-cron-secret
